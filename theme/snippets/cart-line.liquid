{%- comment -%} One cart line: product, size (or "Size to confirm on WhatsApp"), quantity, price. - item, index {%- endcomment -%}
{%- liquid
  assign size_later = false
  if item.properties.Size == settings.size_later_property
    assign size_later = true
  endif
-%}
<li class="cart-line" data-line="{{ index }}" data-key="{{ item.key }}">
  <a href="{{ item.url }}" tabindex="-1" aria-hidden="true">
    <div class="media cart-line__media">
      {%- if item.image -%}{{ item.image | image_url: width: 200 | image_tag: widths: '100, 150, 200', sizes: '72px', loading: 'lazy', alt: '' }}{%- endif -%}
    </div>
  </a>
  <div>
    <a class="cart-line__title" href="{{ item.url }}">{{ item.product.title }}</a>
    {%- if size_later -%}
      <p class="cart-line__meta cart-line__meta--flag">Size to confirm on WhatsApp</p>
    {%- else -%}
      {%- for option in item.options_with_values -%}
        <p class="cart-line__meta">{{ option.name }}: {{ option.value }}</p>
      {%- endfor -%}
    {%- endif -%}
    {%- for p in item.properties -%}
      {%- assign first_char = p.first | slice: 0 -%}
      {%- if p.last == blank or first_char == '_' or p.first == 'Size' -%}{%- continue -%}{%- endif -%}
      <p class="cart-line__meta">{{ p.first }}: {{ p.last }}</p>
    {%- endfor -%}
    {%- if item.final_line_price > 0 -%}
      <div class="qty">
        <button type="button" data-qty-change="{{ item.quantity | minus: 1 }}" aria-label="One less {{ item.product.title | escape }}">−</button>
        <input type="number" min="0" value="{{ item.quantity }}" aria-label="Quantity of {{ item.product.title | escape }}" data-qty-input inputmode="numeric">
        <button type="button" data-qty-change="{{ item.quantity | plus: 1 }}" aria-label="One more {{ item.product.title | escape }}">+</button>
      </div>
    {%- else -%}
      <p class="cart-line__meta">Free gift</p>
    {%- endif -%}
  </div>
  <div class="cart-line__end">
    <span class="price">
      {{- item.final_line_price | money_without_trailing_zeros -}}
      {%- if item.original_line_price > item.final_line_price %}<s>{{ item.original_line_price | money_without_trailing_zeros }}</s>{% endif -%}
    </span>
    <button type="button" class="link cart-line__remove" data-qty-change="0">Remove<span class="visually-hidden"> {{ item.product.title }}</span></button>
  </div>
</li>
