{%- comment -%} Minimal product data for quick add and the product form. Kept small on purpose. {%- endcomment -%}
<script type="application/json" data-product-json>
  {
    "id": {{ product.id }},
    "title": {{ product.title | json }},
    "url": {{ product.url | json }},
    "image": {{ product.featured_media.preview_image | image_url: width: 240 | json }},
    "options": {{ product.options | json }},
    "variants": [
      {%- for v in product.variants -%}
        {"id": {{ v.id }}, "options": {{ v.options | json }}, "available": {{ v.available | json }}, "price": {{ v.price }}}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>
