{%- paginate blog.articles by 12 -%}
<div class="page-width section">
  <h1 class="h1">{{ blog.title }}</h1>
  <div class="grid">
    {%- for article in blog.articles -%}
      <a class="mood" href="{{ article.url }}">{% render 'media', image: article.image, ratio: 'portrait', sizes: '(min-width: 990px) 22vw, 46vw' %}<span class="mood__title">{{ article.title }}</span></a>
    {%- endfor -%}
  </div>
  {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="Pages">{{ paginate | default_pagination }}</nav>{%- endif -%}
</div>
{%- endpaginate -%}
{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
