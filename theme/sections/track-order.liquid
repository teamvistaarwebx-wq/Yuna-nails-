<div class="section">
  <div class="page-width" style="max-width:640px">
    <h1 class="h1">{{ section.settings.heading }}</h1>
    <p class="lead muted">{% render 'fact', text: section.settings.text %}</p>
    {%- for block in section.blocks -%}{% render block %}{%- endfor -%}
    {%- if section.settings.tracking_url != blank -%}
      <p style="margin-top:24px"><a class="button button--full" href="{{ section.settings.tracking_url }}" target="_blank" rel="noopener">Track my order</a></p>
    {%- endif -%}
    <div class="stack" style="margin-top:24px">
      {%- if shop.customer_accounts_enabled -%}<a class="button button--secondary button--full" href="{{ routes.account_url }}">See my orders</a>{%- endif -%}
      <a class="link" href="{% render 'whatsapp-url', message: 'Hi Yuna, where is my order?' %}" target="_blank" rel="noopener">Ask us on WhatsApp</a>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Track order",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Track your order" },
    { "type": "text", "id": "text", "label": "Text", "default": "Each set is made to order and dispatched in [dispatch_time]. You'll get tracking details by SMS and email." },
    { "type": "url", "id": "tracking_url", "label": "Tracking page link", "info": "The current tracking app's page. Or add its app block." }
  ],
  "blocks": [ { "type": "@app" } ],
  "presets": [ { "name": "Track order" } ]
}
{% endschema %}
