{%- comment -%} Below the buy box: what's in the box, how to apply, removal, safety, sizing, FAQ. Each is a block, so order and wording stay editable. {%- endcomment -%}
<div class="section section--tight">
  <div class="page-width">
    <div class="{% if section.settings.narrow %}two-col{% endif %}">
      {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}
      <div>
        {%- for block in section.blocks -%}
          {%- liquid
            assign open = false
            if forloop.first and section.settings.open_first
              assign open = true
            endif
          -%}
          <details class="accordion" {{ block.shopify_attributes }}{% if open %} open{% endif %}>
            <summary>{{ block.settings.title }}</summary>
            <div class="accordion__body">
              {%- case block.type -%}
                {%- when 'description' -%}
                  <div class="rte">{{ product.description }}</div>
                {%- when 'box' -%}
                  {%- assign items = settings.box_contents | newline_to_br | split: '<br />' -%}
                  <ul class="box-list">{%- for item in items -%}{%- assign i = item | strip -%}{%- if i != blank -%}<li>{% render 'fact', text: i %}</li>{%- endif -%}{%- endfor -%}</ul>
                  {%- if block.settings.image != blank -%}<div style="margin-top:16px">{% render 'media', image: block.settings.image, ratio: 'portrait', sizes: '(min-width: 990px) 40vw, 100vw' %}</div>{%- endif -%}
                {%- when 'steps' -%}
                  {%- if block.settings.video != blank -%}<div style="max-width:320px;margin-bottom:16px">{% render 'media', video: block.settings.video, image: block.settings.poster, ratio: 'tall', sizes: '320px' %}</div>{%- endif -%}
                  <div class="rte">{% render 'fact', text: block.settings.text %}</div>
                {%- when 'safety' -%}
                  <div class="note rte">{{ settings.safety_notes }}</div>
                {%- when 'sizing' -%}
                  {% render 'size-chart' %}
                  <p class="small" style="margin-top:12px">{% render 'fact', text: block.settings.text %}</p>
                {%- when 'faq' -%}
                  <div class="rte">{% render 'fact', text: block.settings.text %}</div>
              {%- endcase -%}
            </div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Product details",
  "class": "section-product-details",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "checkbox", "id": "open_first", "label": "Open the first item", "default": true },
    { "type": "checkbox", "id": "narrow", "label": "Heading beside the list on desktop", "default": false }
  ],
  "blocks": [
    { "type": "description", "name": "Product description", "limit": 1, "settings": [ { "type": "text", "id": "title", "label": "Title", "default": "About this design" } ] },
    { "type": "box", "name": "What's in the box", "limit": 1, "settings": [ { "type": "text", "id": "title", "label": "Title", "default": "What's in the box" }, { "type": "paragraph", "content": "Contents come from Theme settings > Facts." }, { "type": "image_picker", "id": "image", "label": "Unboxing photo (4:5)" } ] },
    { "type": "steps", "name": "Steps (apply or remove)", "settings": [ { "type": "text", "id": "title", "label": "Title", "default": "How to apply" }, { "type": "video", "id": "video", "label": "Video (9:16, works muted)" }, { "type": "image_picker", "id": "poster", "label": "Poster frame" }, { "type": "richtext", "id": "text", "label": "Steps", "default": "<ol><li>Clean and dry your nails. Push back cuticles and buff lightly.</li><li>Match a press-on to each nail before you start.</li><li>Add a thin layer of nail glue to your nail and to the press-on.</li><li>Press it on at an angle from the cuticle, then hold firmly.</li></ol><p>Takes about [apply_minutes] minutes.</p>" } ] },
    { "type": "safety", "name": "Safety notes", "limit": 1, "settings": [ { "type": "text", "id": "title", "label": "Title", "default": "Safety notes" }, { "type": "paragraph", "content": "Notes come from Theme settings > Facts." } ] },
    { "type": "sizing", "name": "Size and fit", "limit": 1, "settings": [ { "type": "text", "id": "title", "label": "Title", "default": "Size and fit" }, { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Wrong size? Exchange it free within [exchange_window].</p>" } ] },
    { "type": "faq", "name": "Question", "settings": [ { "type": "text", "id": "title", "label": "Question", "default": "How long do they last?" }, { "type": "richtext", "id": "text", "label": "Answer", "default": "<p>Reusable for about [wear_count] wears with gentle removal.</p>" } ] }
  ],
  "presets": [ { "name": "Product details" } ]
}
{% endschema %}
