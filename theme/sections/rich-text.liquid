<div class="section{% if section.settings.surface %} section--surface{% endif %}">
  <div class="page-width" style="max-width:760px">
    <div class="{% if section.settings.center %}center{% endif %}">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}
      <div class="rte lead">{% render 'fact', text: section.settings.text %}</div>
      {%- if section.settings.button_label != blank -%}<p style="margin-top:24px"><a class="button button--secondary" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a></p>{%- endif -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line above" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "center", "label": "Centre", "default": false },
    { "type": "checkbox", "id": "surface", "label": "Soft background", "default": false }
  ],
  "presets": [ { "name": "Rich text" } ]
}
{% endschema %}
