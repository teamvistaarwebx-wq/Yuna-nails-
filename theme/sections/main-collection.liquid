{%- paginate collection.products by section.settings.per_page -%}
<div class="page-width">
  <div class="collection-head">
    <h1 class="h1">{{ collection.title }}</h1>
    {%- if collection.description != blank and section.settings.show_description -%}<div class="rte muted">{{ collection.description }}</div>{%- endif -%}
  </div>

  {%- if section.settings.show_filters -%}
    <div class="facets" aria-label="Filters">
      {%- for filter in collection.filters -%}
        {%- if filter.type == 'list' -%}
          {%- for value in filter.values -%}
            {%- if value.count == 0 and value.active == false -%}{%- continue -%}{%- endif -%}
            <a class="facet-chip{% if value.active %} is-active{% endif %}" href="{% if value.active %}{{ value.url_to_remove }}{% else %}{{ value.url_to_add }}{% endif %}"{% if value.active %} aria-current="true"{% endif %}>
              {{ value.label }}{% if value.active %} <span aria-hidden="true">×</span><span class="visually-hidden">(remove filter)</span>{% endif %}
            </a>
          {%- endfor -%}
        {%- endif -%}
      {%- endfor -%}
      <form class="facet-chip" method="get">
        {%- for filter in collection.filters -%}{%- for value in filter.active_values -%}<input type="hidden" name="{{ value.param_name }}" value="{{ value.value }}">{%- endfor -%}{%- endfor -%}
        <label class="visually-hidden" for="SortBy">Sort by</label>
        <select id="SortBy" name="sort_by" onchange="this.form.submit()">
          {%- for option in collection.sort_options -%}<option value="{{ option.value }}"{% if option.value == collection.sort_by %} selected{% endif %}>{{ option.name }}</option>{%- endfor -%}
        </select>
        <noscript><button type="submit" class="button button--small">Sort</button></noscript>
      </form>
    </div>
  {%- endif -%}

  {%- if collection.products.size > 0 -%}
    <div class="grid">
      {%- for product in collection.products -%}
        {%- assign eager = false -%}{%- if forloop.index <= 2 -%}{%- assign eager = true -%}{%- endif -%}
        {% render 'product-card', product: product, priority: eager %}
      {%- endfor -%}
    </div>
  {%- else -%}
    <div class="cart-empty"><p>No designs match these filters.</p><a class="button button--secondary" href="{{ collection.url }}">Clear filters</a></div>
  {%- endif -%}

  {%- if paginate.pages > 1 -%}
    <nav class="pagination" aria-label="Pages">
      {%- for part in paginate.parts -%}
        {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- elsif part.title == paginate.current_page -%}<span class="is-current" aria-current="page">{{ part.title }}</span>{%- else -%}<span>{{ part.title }}</span>{%- endif -%}
      {%- endfor -%}
    </nav>
  {%- endif -%}
</div>
<div class="section--tight"></div>
{%- endpaginate -%}
{% schema %}
{
  "name": "Collection",
  "class": "section-main-collection",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "checkbox", "id": "show_description", "label": "Show description", "default": false },
    { "type": "checkbox", "id": "show_filters", "label": "Show filters and sorting", "default": true, "info": "Filters come from Search & Discovery. Keep only light ones (colour, shape)." }
  ]
}
{% endschema %}
