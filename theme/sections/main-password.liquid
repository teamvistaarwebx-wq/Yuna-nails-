<div class="section center"><div class="page-width" style="max-width:480px">
  <h1 class="h1">{{ shop.name }}</h1>
  {%- if shop.password_message != blank -%}<p class="lead">{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password', class: 'stack' -%}
    {%- if form.errors -%}<p class="form-message form-message--error" role="alert">Wrong password.</p>{%- endif -%}
    <label class="visually-hidden" for="Password">Password</label>
    <div class="inline-form"><input class="input" id="Password" type="password" name="password" autocomplete="current-password" placeholder="Password"><button class="button" type="submit">Enter</button></div>
  {%- endform -%}
</div></div>
{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}
