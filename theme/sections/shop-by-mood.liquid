<div class="section">
  <div class="page-width">
    <div class="section__head"><h2 class="h2">{{ section.settings.heading }}</h2></div>
    <div class="grid">
      {%- for block in section.blocks -%}
        <a class="mood" href="{{ block.settings.collection.url | default: '#' }}" {{ block.shopify_attributes }}>
          {% render 'media', image: block.settings.image, ratio: 'portrait', sizes: '(min-width: 990px) 22vw, 46vw', label: 'Mood photo 4:5' %}
          <span class="mood__title">{% render 'fact', text: block.settings.title %}<span aria-hidden="true">→</span></span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Shop by mood",
  "settings": [ { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Shop by <em>mood</em>" } ],
  "blocks": [
    { "type": "mood", "name": "Mood", "settings": [
      { "type": "text", "id": "title", "label": "Mood", "default": "[[TO CONFIRM: mood]]" },
      { "type": "image_picker", "id": "image", "label": "Photo (4:5)" },
      { "type": "collection", "id": "collection", "label": "Collection" }
    ] }
  ],
  "max_blocks": 6,
  "presets": [ { "name": "Shop by mood", "blocks": [ { "type": "mood" }, { "type": "mood" }, { "type": "mood" }, { "type": "mood" } ] } ]
}
{% endschema %}
