{%- assign c = section.settings.collection -%}
<div class="section">
  <div class="page-width">
    <div class="section__head">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="muted">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="grid">
      {%- if c != blank -%}
        {%- for p in c.products limit: section.settings.limit -%}{% render 'product-card', product: p %}{%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="card"><div class="media media--portrait">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}<span class="media__label">Hand photo 4:5</span></div><div class="card__body"><p class="card__title">Choose a collection</p></div></div>
        {%- endfor -%}
      {%- endif -%}
    </div>
    {%- if c != blank and section.settings.button_label != blank -%}<div class="section__foot center"><a class="button button--secondary" href="{{ c.url }}">{{ section.settings.button_label }}</a></div>{%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line above", "default": "Most loved" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Bestsellers" },
    { "type": "text", "id": "text", "label": "Text", "default": "Our top-reviewed sets." },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "For bestsellers: a manually curated collection of top-reviewed sets." },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 12, "step": 2, "default": 4 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop all bestsellers" }
  ],
  "presets": [ { "name": "Featured collection" } ]
}
{% endschema %}
