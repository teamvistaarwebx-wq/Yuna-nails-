<div class="section section--surface">
  <div class="page-width">{% render 'kit-block', heading: section.settings.heading, text: section.settings.text, form_id: section.id %}</div>
</div>
{% schema %}
{
  "name": "Nail care kit",
  "settings": [
    { "type": "paragraph", "content": "Switches between 'coming soon' and 'launched' with Theme settings > Products > 'Nail care kit is coming soon'." },
    { "type": "text", "id": "heading", "label": "Heading (leave empty to use the kit name)" },
    { "type": "text", "id": "text", "label": "Text (leave empty to use the kit promise)" }
  ],
  "presets": [ { "name": "Nail care kit" } ]
}
{% endschema %}
